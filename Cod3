-- ---------- time para torre e raid ----------
local cardsCfg
local function cardPower(tool)
    if cardsCfg == nil then
        local ok, cfg = pcall(function() return require(RS.Modules.CardsConfig) end)
        cardsCfg = (ok and type(cfg) == "table" and type(cfg.Cards) == "table") and cfg.Cards or false
    end
    local entry = cardsCfg and cardsCfg[tool:GetAttribute("CardName")]
    return (entry and entry.BaseRevenue) or 0, tool:GetAttribute("CardLevel") or 0
end

-- melhores cartas da mochila (as que estão nos slots não são ferramentas)
local function bestTeam(n)
    local bp = lp:FindFirstChild("Backpack")
    local tools = {}
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("CardName") ~= nil then
                tools[#tools + 1] = t
            end
        end
    end
    table.sort(tools, function(a, b)
        local ra, la = cardPower(a)
        local rb, lb = cardPower(b)
        if ra ~= rb then
            return ra > rb
        end
        return la > lb
    end)
    local team = {}
    for i = 1, math.min(n, #tools) do
        team[i] = tools[i]
    end
    return team
end

local function onTower(action, data)
    if action == "BattleAccepted" then
        S.towerAck = os.clock()
    elseif action == "RewardResult" and type(data) == "table" then
        Say("Torre", "Andar " .. tostring(data.Floor) .. " (" .. tostring(data.Difficulty) .. ")")
    end
end

local function towerLoop()
    local stateAt, fails, noCardAt = -1000, 0, -100
    while S.tower do
        local r = remote("InfinityTowerRE")
        if r and not lp:GetAttribute("InfinityTowerInBattle") and not lp:GetAttribute("BossRaidInBattle") then
            local diff = S.towerDiff
            if lp:GetAttribute("InfinityTowerUnlocked" .. diff) == false then
                Say("Torre", "A dificuldade " .. diff .. " ainda está bloqueada")
                S.tower = false
                break
            end
            if os.clock() - stateAt > 300 then
                stateAt = os.clock()
                r:FireServer("RequestTowerState")
                task.wait(0.5)
            end
            local team = bestTeam(S.teamSize)
            if #team == 0 then
                if os.clock() - noCardAt > 60 then
                    noCardAt = os.clock()
                    Say("Torre", "Sem cartas na mochila para montar o time")
                end
                task.wait(10)
            else
                local stamp = S.towerAck
                r:FireServer("StartBattle", { Team = team, Difficulty = diff })
                local t0 = os.clock()
                while S.towerAck == stamp and os.clock() - t0 < 4 do
                    task.wait(0.1)
                end
                if S.towerAck == stamp then
                    -- sem BattleAccepted: o servidor pode limitar o tamanho do time
                    fails = fails + 1
                    S.teamSize = math.max(1, #team - 1)
                    if fails == 3 then
                        Say("Torre", "O servidor não aceitou o início (time de " .. #team .. ")")
                    end
                    task.wait(3)
                else
                    fails = 0
                    local t1 = os.clock()
                    task.wait(2)
                    while S.tower and lp:GetAttribute("InfinityTowerInBattle") and os.clock() - t1 < CFG.FightTimeout do
                        task.wait(1)
                    end
                end
            end
        end
        task.wait(2)
    end
end

local function onRaid(action, data)
    if action == "State" and type(data) == "table" then
        S.raidState, S.raidAt = data, os.clock()
    end
end

local function triedAlready(state, diff)
    local td = state.TriedDifficulties
    if type(td) ~= "table" then
        return false
    end
    if td[diff] then
        return true
    end
    for _, v in pairs(td) do
        if v == diff then
            return true
        end
    end
    return false
end

local function raidLoop()
    local lastTry = {}
    local noCardAt = -100
    while S.raid do
        local st = S.raidState
        local r = remote("BossRaidRE")
        if st and r and not lp:GetAttribute("BossRaidInBattle") and not lp:GetAttribute("InfinityTowerInBattle") then
            local left = (st.TimeLeftInWindow or 0) - (os.clock() - S.raidAt)
            local key = tostring(st.DisplayedBossId) .. ":" .. S.raidDiff
            if not st.DisplayedBossIsPreview and left > 15 and not triedAlready(st, S.raidDiff)
                and os.clock() - (lastTry[key] or -1000) > 60 then
                local team = bestTeam(S.teamSize)
                if #team == 0 then
                    if os.clock() - noCardAt > 60 then
                        noCardAt = os.clock()
                        Say("Raid", "Sem cartas na mochila para montar o time")
                    end
                else
                    lastTry[key] = os.clock()
                    Say("Raid", "Entrando em " .. tostring(st.DisplayedBossName) .. " (" .. S.raidDiff .. ")")
                    r:FireServer("StartFight", { Team = team, Difficulty = S.raidDiff })
                    local t0 = os.clock()
                    while not lp:GetAttribute("BossRaidInBattle") and os.clock() - t0 < 6 do
                        task.wait(0.2)
                    end
                    if lp:GetAttribute("BossRaidInBattle") then
                        local t1 = os.clock()
                        while S.raid and lp:GetAttribute("BossRaidInBattle") and os.clock() - t1 < CFG.FightTimeout do
                            task.wait(1)
                        end
                    else
                        S.teamSize = math.max(1, #team - 1)
                        Say("Raid", "O servidor não iniciou a luta")
                    end
                end
            end
        end
        task.wait(3)
    end
end

