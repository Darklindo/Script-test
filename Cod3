-- AUTO FARM DINÂMICO
local autoFarmActive = false
createToggle("🌾 Auto Farm Dinâmico (Bypass Protegido)", function(s)
    autoFarmActive = s
end)

task.spawn(function()
    while true do
        if autoFarmActive then
            pcall(function()
                local stagePos = STAGE_MAP_TRAIL1[selectedTargetStage]
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if not baseCFrame then
                    statusBox.Text = "Status: Defina sua Base primeiro!"
                    task.wait(1)
                    return
                end
                
                if stagePos and hrp then
                    -- 1. VAI PARA A FASE
                    statusBox.Text = "Status: Indo para o Estágio " .. selectedTargetStage .. "..."
                    ultraBypassTween(CFrame.new(stagePos + Vector3.new(0, 3, 0)))
                    task.wait(0.2)
                    
                    -- 2. BUSCA OVOS NA FASE
                    statusBox.Text = "Status: Procurando ovos ativos..."
                    local localNests = Workspace:FindFirstChild("LocalNests")
                    local targetPrompt = nil
                    local minPromptDist = math.huge
                    
                    if localNests then
                        for _, desc in ipairs(localNests:GetDescendants()) do
                            if desc:IsA("ProximityPrompt") then
                                local promptPart = desc.Parent
                                local pPos = promptPart and (promptPart:IsA("BasePart") and promptPart.Position or (promptPart:IsA("Model") and promptPart.PrimaryPart and promptPart.PrimaryPart.Position))
                                if pPos then
                                    local distToStage = (stagePos - pPos).Magnitude
                                    if distToStage <= 120 then
                                        local distToPlayer = (hrp.Position - pPos).Magnitude
                                        if distToPlayer < minPromptDist then
                                            minPromptDist = distToPlayer
                                            targetPrompt = desc
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    -- 3. PEGA O OVO
                    if targetPrompt and targetPrompt.Parent then
                        local eggPart = targetPrompt.Parent
                        local eggCFrame = eggPart:IsA("BasePart") and eggPart.CFrame or (eggPart:IsA("Model") and eggPart:GetPivot() or nil)
                        
                        if eggCFrame then
                            statusBox.Text = "Status: Coletando ovo..."
                            ultraBypassTween(eggCFrame + Vector3.new(0, 2, 0))
                            task.wait(0.1)
                            
                            fireproximityprompt(targetPrompt)
                            if actionRemote then 
                                actionRemote:FireServer("PickUp", eggPart.Name) 
                                actionRemote:FireServer("StealEgg", eggPart.Name)
                            end
                            task.wait(0.3)
                        end
                    end
                    
                    -- 4. RETORNA À BASE COM DESACELERAÇÃO SUAVE (Evita cair da mão)
                    if player:GetAttribute("CarryEgg") == true then
                        statusBox.Text = "Status: Retornando para a Base (Pouso Suave)..."
                        -- Usa velocidade reduzida (80) no trecho final para o ovo não sumir
                        ultraBypassTween(baseCFrame, math.min(userTweenSpeed, 85))
                        task.wait(0.3)
                        
                        -- Depósito Verificado na Base
                        if actionRemote then
                            actionRemote:FireServer("PlaceEgg")
                            actionRemote:FireServer("StoreEgg")
                            actionRemote:FireServer("Deposit")
                        end
                        statusBox.Text = "Status: Ovo Entregue na Base!"
                        task.wait(0.5)
                    end
                end
            end)
        else
            statusBox.Text = "Status: Em repouso."
        end
        task.wait(0.3)
    end
end)

