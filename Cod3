local function ScanGame()
    local Players = game:GetService("Players")
    local RS = game:GetService("ReplicatedStorage")
    local lp = Players.LocalPlayer
    local out = {}
    local function add(line) out[#out + 1] = line end
    local function path(inst)
        local ok, p = pcall(function() return inst:GetFullName() end)
        return ok and p or tostring(inst)
    end
    local function attrs(inst)
        local ok, a = pcall(function() return inst:GetAttributes() end)
        if not ok or not a then
            return ""
        end
        local parts = {}
        for k, v in pairs(a) do
            parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
        end
        table.sort(parts)
        return table.concat(parts, ", ")
    end
    local function serv(v, d)
        local t = typeof(v)
        if t == "string" then
            return '"' .. v:sub(1, 30) .. '"'
        elseif t == "number" or t == "boolean" or t == "nil" then
            return tostring(v)
        elseif t == "table" then
            if d >= 3 then
                return "{...}"
            end
            local parts, n = {}, 0
            for k, val in pairs(v) do
                n = n + 1
                if n > 40 then
                    parts[#parts + 1] = "..."
                    break
                end
                parts[#parts + 1] = tostring(k) .. "=" .. serv(val, d + 1)
            end
            return "{" .. table.concat(parts, ", ") .. "}"
        end
        return t
    end
    local function dumpTree(inst, indent, depthLeft, counter)
        if counter.n >= counter.max then
            return
        end
        if inst:IsA("Decal") or inst:IsA("Texture") then
            return
        end
        counter.n = counter.n + 1
        local line = string.rep("  ", indent) .. inst.ClassName .. " " .. inst.Name
        if inst:IsA("ValueBase") then
            local ok, val = pcall(function() return inst.Value end)
            line = line .. " = " .. tostring(ok and val or "?")
        end
        if inst:IsA("TextLabel") or inst:IsA("TextButton") then
            line = line .. " '" .. tostring(inst.Text) .. "'"
        end
        local a = attrs(inst)
        if a ~= "" then
            line = line .. " [" .. a .. "]"
        end
        add(line)
        if depthLeft > 0 then
            for _, c in ipairs(inst:GetChildren()) do
                dumpTree(c, indent + 1, depthLeft - 1, counter)
            end
        end
    end

    add("=== SCAN ANIME CARD FARM ===")
    add("PlaceId: " .. tostring(game.PlaceId) .. " | GameId: " .. tostring(game.GameId))

    -- Remotes
    add("")
    add("--- REMOTES (E=Event, F=Function; relativo a ReplicatedStorage) ---")
    local nR = 0
    for _, d in ipairs(RS:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d.ClassName == "UnreliableRemoteEvent" then
            nR = nR + 1
            if nR <= 400 then
                local full = (path(d):gsub("^ReplicatedStorage%.", ""))
                add((d:IsA("RemoteFunction") and "F " or "E ") .. full)
            end
        end
    end
    add("Total de remotes: " .. nR)
    local others = 0
    for _, root in ipairs({ workspace, game:GetService("ReplicatedFirst") }) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                others = others + 1
                if others <= 40 then
                    add("(fora do ReplicatedStorage) " .. path(d))
                end
            end
        end
    end

    -- ReplicatedStorage (nível 1 e conteúdo)
    add("")
    add("--- REPLICATEDSTORAGE ---")
    for n, c in ipairs(RS:GetChildren()) do
        if n > 80 then
            add("...")
            break
        end
        local names, k = {}, 0
        for _, cc in ipairs(c:GetChildren()) do
            k = k + 1
            if k > 30 then
                names[#names + 1] = "..."
                break
            end
            names[#names + 1] = cc.Name
        end
        add(c.ClassName .. ": " .. c.Name .. " -> " .. table.concat(names, ", "))
    end

    -- Jogador
    add("")
    add("--- JOGADOR ---")
    local pa = attrs(lp)
    add("Atributos: " .. (pa ~= "" and pa or "(nenhum)"))
    local ls = lp:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            local ok, val = pcall(function() return v.Value end)
            add("leaderstat " .. v.ClassName .. " " .. v.Name .. " = " .. tostring(ok and val or "?"))
        end
    end
    for _, folder in ipairs(lp:GetChildren()) do
        if folder:IsA("Folder") or folder:IsA("Configuration") then
            local names = {}
            for i, c in ipairs(folder:GetChildren()) do
                if i > 25 then
                    names[#names + 1] = "..."
                    break
                end
                names[#names + 1] = c.Name
            end
            add("Pasta no jogador: " .. folder.Name .. " -> " .. table.concat(names, ", "))
        end
    end

    local containers = { lp:FindFirstChild("Backpack"), lp.Character }
    for ci = 1, 2 do
        local container = containers[ci]
        if container then
            local nT = 0
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") then
                    nT = nT + 1
                    if nT <= 15 then
                        add("Tool: " .. t.Name .. " (em " .. container.Name .. ") [" .. attrs(t) .. "]")
                    end
                end
            end
            if nT > 15 then
                add("... +" .. (nT - 15) .. " tools")
            end
        end
    end

    -- Interface
    add("")
    add("--- INTERFACE (PlayerGui) ---")
    local pg = lp:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, g in ipairs(pg:GetChildren()) do
            local en = g:IsA("ScreenGui") and tostring(g.Enabled) or "-"
            add(g.ClassName .. ": " .. g.Name .. " (Enabled=" .. en .. ")")
        end
        add("")
        add("--- BOTOES (primeiros 150) ---")
        local bN = 0
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("TextButton") or d:IsA("ImageButton") then
                bN = bN + 1
                if bN <= 150 then
                    local txt = d:IsA("TextButton") and d.Text or ""
                    add(d.ClassName .. " '" .. txt .. "' " .. path(d))
                end
            end
        end
    end

    -- Workspace
    add("")
    add("--- WORKSPACE (nivel superior) ---")
    for n, c in ipairs(workspace:GetChildren()) do
        if n > 80 then
            add("...")
            break
        end
        add(c.ClassName .. ": " .. c.Name)
    end

    -- Prompts e cliques
    local prompts, pOrder = {}, {}
    local clicks, cOrder = {}, {}
    local i = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        i = i + 1
        if i % 3000 == 0 then
            task.wait()
        end
        if d:IsA("ProximityPrompt") then
            local key = tostring(d.ActionText) .. " | " .. tostring(d.ObjectText) .. " | pai: " .. (d.Parent and d.Parent.Name or "?")
            if not prompts[key] then
                prompts[key] = { count = 0, first = path(d) }
                pOrder[#pOrder + 1] = key
            end
            prompts[key].count = prompts[key].count + 1
        elseif d:IsA("ClickDetector") then
            local key = d.Parent and d.Parent.Name or "?"
            if not clicks[key] then
                clicks[key] = { count = 0, first = path(d) }
                cOrder[#cOrder + 1] = key
            end
            clicks[key].count = clicks[key].count + 1
        end
    end
    add("")
    add("--- PROXIMITY PROMPTS ---")
    for n, key in ipairs(pOrder) do
        if n > 40 then
            add("...")
            break
        end
        add(key .. " x" .. prompts[key].count .. "  ex: " .. prompts[key].first)
    end
    add("")
    add("--- CLICK DETECTORS ---")
    for n, key in ipairs(cOrder) do
        if n > 30 then
            add("...")
            break
        end
        add(key .. " x" .. clicks[key].count .. "  ex: " .. clicks[key].first)
    end

    -- Plots (o jogo tem um plot por jogador)
    add("")
    add("--- PLOTS (Workspace.MAP.Plots) ---")
    local mapF = workspace:FindFirstChild("MAP")
    local plotsF = mapF and mapF:FindFirstChild("Plots")
    if plotsF then
        local function mentionsMe(inst)
            local a = attrs(inst)
            return a:find(lp.Name, 1, true) ~= nil or a:find(tostring(lp.UserId), 1, true) ~= nil
        end
        local mine
        for _, pl in ipairs(plotsF:GetChildren()) do
            local kids = {}
            for k, c in ipairs(pl:GetChildren()) do
                if k > 12 then
                    kids[#kids + 1] = "..."
                    break
                end
                local ca = attrs(c)
                kids[#kids + 1] = c.Name .. (ca ~= "" and ("[" .. ca:sub(1, 80) .. "]") or "")
                if mentionsMe(c) then
                    mine = mine or pl
                end
            end
            if mentionsMe(pl) then
                mine = mine or pl
            end
            add("plot " .. pl.Name .. " [" .. attrs(pl):sub(1, 120) .. "] -> " .. table.concat(kids, ", "))
        end
        if mine then
            add("# SEU PLOT: " .. mine.Name)
            dumpTree(mine, 0, 3, { n = 0, max = 110 })
        else
            add("(não consegui identificar o seu plot pelos atributos)")
        end
    else
        add("(Workspace.MAP.Plots não existe)")
    end

    -- Módulos de configuração (preços, cartas, packs, mutações...)
    add("")
    add("--- MODULOS DE DADOS (ReplicatedStorage) ---")
    local words = { "config", "registry", "pack", "card", "shop", "upgrade", "rebirth", "mutation",
        "rarity", "price", "data", "world", "boost", "quest", "reward", "index", "settings", "stat",
        "conveyor", "floor", "luck", "artifact", "boss", "trait", "grade", "ascension", "craft",
        "tower", "limited", "offline", "time", "gamepass", "cash" }
    local shown = 0
    for _, d in ipairs(RS:GetDescendants()) do
        if d:IsA("ModuleScript") and shown < 30 then
            local ln = d.Name:lower()
            local match = false
            for _, w in ipairs(words) do
                if ln:find(w, 1, true) then
                    match = true
                    break
                end
            end
            if match then
                shown = shown + 1
                local okReq, data = pcall(require, d)
                if okReq then
                    add("# " .. path(d))
                    add(serv(data, 0):sub(1, 2200))
                else
                    add("# " .. path(d) .. ": require falhou (" .. tostring(data) .. ")")
                end
            end
        end
    end

    -- Telas principais em detalhe (ignora as do sistema)
    if pg then
        add("")
        add("--- TELAS EM DETALHE ---")
        local skip = { "topbar", "touchgui", "backpackgui", "proximityprompts", "cmdr" }
        local done = 0
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and done < 6 then
                local ln = g.Name:lower()
                local skipIt = false
                for _, w in ipairs(skip) do
                    if ln:find(w, 1, true) then
                        skipIt = true
                        break
                    end
                end
                if not skipIt then
                    done = done + 1
                    add("# " .. g.Name)
                    dumpTree(g, 0, 4, { n = 0, max = 45 })
                end
            end
        end
    end

    add("")
    add("=== FIM DO SCAN ===")
    return table.concat(out, "\n")
end

