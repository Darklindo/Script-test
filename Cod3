local function remote(name)
    local rf = RS:FindFirstChild("Remotes")
    return (rf and rf:FindFirstChild(name)) or RS:FindFirstChild(name)
end

local function connect(name, fn)
    local r = remote(name)
    if r and r:IsA("RemoteEvent") then
        conns[#conns + 1] = r.OnClientEvent:Connect(fn)
    end
end

local function short(n)
    if type(n) ~= "number" then
        return tostring(n)
    end
    return string.format("%.3g", n)
end

-- ---------- seu plot ----------
local function findMyPlot()
    local map = workspace:FindFirstChild("MAP")
    local plots = map and map:FindFirstChild("Plots")
    if not plots then
        return nil
    end
    -- 1) pelo nome no álbum do plot
    local nameA, nameB = lp.DisplayName, lp.Name
    for _, pl in ipairs(plots:GetChildren()) do
        local root = pl:FindFirstChild("Plot_N0") or pl
        local album = root:FindFirstChild("AlbumModel")
        local prompt = album and album:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            local t = prompt.ObjectText
            if (nameA ~= "" and t:find(nameA, 1, true)) or (nameB ~= "" and t:find(nameB, 1, true)) then
                return root
            end
        end
    end
    -- 2) pelo número visto nos eventos da esteira
    if S.plotNumber then
        local pl = plots:FindFirstChild(tostring(S.plotNumber))
        if pl then
            return pl:FindFirstChild("Plot_N0") or pl
        end
    end
    -- 3) o plot mais perto do personagem
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local best, bestD
        for _, pl in ipairs(plots:GetChildren()) do
            local r0 = pl:FindFirstChild("Plot_N0") or pl
            local ref = r0:FindFirstChild("ButtonPart") or r0:FindFirstChild("SellPart")
            if ref and ref:IsA("BasePart") then
                local d = (ref.Position - hrp.Position).Magnitude
                if not bestD or d < bestD then
                    best, bestD = r0, d
                end
            end
        end
        if best and bestD < 200 then
            return best
        end
    end
    return nil
end

local function promptPos(prompt)
    local p = prompt.Parent
    if p and p:IsA("BasePart") then
        return p.Position
    end
    if p and p:IsA("Attachment") then
        return p.WorldPosition
    end
    local part = p and p:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

-- slots que têm carta (o prompt "Remove" aparece em slot ocupado)
local function occupiedSlots()
    local plotRoot = findMyPlot()
    if not plotRoot then
        return nil
    end
    local slots = {}
    for _, d in ipairs(plotRoot:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.ActionText == "Remove" and d.ObjectText == ""
            and d.Parent and d.Parent.Name == "PromptHolder" then
            local holder = d.Parent.Parent
            local n = holder and tonumber(holder.Name:match("^CardSlot(%d+)$"))
            if n then
                slots[#slots + 1] = n
            end
        end
    end
    table.sort(slots)
    return slots
end

-- ---------- esteira e packs ----------
local function backpackCount()
    local bp = lp:FindFirstChild("Backpack")
    return bp and #bp:GetChildren() or 0
end

local function pendingCount()
    local n = 0
    for id, t in pairs(S.pend) do
        if os.clock() - t > 30 then
            S.pend[id] = nil
        else
            n = n + 1
        end
    end
    return n
end

local invWarnAt = -100
local function tryBuy(itemId, info)
    local cap = (lp:GetAttribute("InventoryMaxSlots") or 150) - CFG.InventoryReserve
    if backpackCount() >= cap then
        if os.clock() - invWarnAt > 60 then
            invWarnAt = os.clock()
            Say("Auto comprar", "Mochila quase cheia (" .. backpackCount() .. ")")
        end
        return
    end
    local r = remote("ConveyorRE")
    if r then
        info.tries = (info.tries or 0) + 1
        r:FireServer("TryBuy", { ItemId = itemId })
    end
end

local function buyPack(itemId, info)
    local before = backpackCount()
    tryBuy(itemId, info)
    task.delay(1.5, function()
        if S.buy and backpackCount() <= before and (info.tries or 0) < 2 then
            tryBuy(itemId, info) -- uma segunda tentativa se nada entrou na mochila
        end
    end)
end

local function onConveyor(action, data)
    if type(data) ~= "table" then
        return
    end
    if data.PlotNumber and not S.plotNumber then
        S.plotNumber = data.PlotNumber
    end
    if action == "ButtonClicked" then
        S.btnAck = os.clock()
    elseif action == "MoveToCAndDestroy" and data.ItemId then
        S.pend[data.ItemId] = nil
    elseif action == "SpawnAndMoveToB" and data.ItemId then
        S.pend[data.ItemId] = os.clock()
        S.packs[data.ItemId] = {
            name = data.PackAssetName or data.PackId, rarity = data.Rarity,
            rank = data.RarityRank or 0, price = data.Price, t = os.clock(),
        }
        for id, info in pairs(S.packs) do -- limpa itens antigos
            if os.clock() - info.t > 180 then
                S.packs[id] = nil
            end
        end
        -- se o aviso "PackAtB" não vier, tenta quando o pack já deve ter chegado
        task.delay(6, function()
            local info = S.packs[data.ItemId]
            if S.buy and info and not info.atB and (info.tries or 0) == 0 and info.rank >= S.minRank then
                buyPack(data.ItemId, info)
            end
        end)
    elseif action == "PackAtB" and data.ItemId then
        local info = S.packs[data.ItemId]
        if info then
            info.atB = true
            if S.buy and info.rank >= S.minRank and (info.tries or 0) == 0 then
                task.spawn(buyPack, data.ItemId, info)
            end
        end
    end
end

-- clica no botão da esteira do seu plot e espera o lote terminar
local function conveyorLoop()
    local warned = false
    while S.conveyor do
        local plotRoot = findMyPlot()
        local btn = plotRoot and plotRoot:FindFirstChild("ButtonPart")
        local cd = btn and btn:FindFirstChildOfClass("ClickDetector")
        if not (cd and fireclickdetector) then
            if not warned then
                warned = true
                Say("Esteira", "Não achei o botão do seu plot (ou o executor não tem fireclickdetector)")
            end
            task.wait(5)
        else
            local char = lp.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local origin
            if root and (root.Position - btn.Position).Magnitude > 20 then
                origin = root.CFrame -- o servidor confere a distância do clique
                root.CFrame = CFrame.new(btn.Position + Vector3.new(0, 3, 5))
                task.wait(0.2)
            end
            local stamp = S.btnAck
            fireclickdetector(cd)
            local t0 = os.clock()
            while S.conveyor and S.btnAck == stamp and os.clock() - t0 < 3 do
                task.wait(0.1)
            end
            if origin and root and root.Parent then
                root.CFrame = origin
            end
            task.wait(CFG.BatchSettle) -- dá tempo dos packs do lote aparecerem
            local t1 = os.clock()
            while S.conveyor and pendingCount() > 0 and os.clock() - t1 < CFG.BatchTimeout do
                task.wait(0.5)
            end
            task.wait(CFG.ConveyorGap)
        end
    end
end

