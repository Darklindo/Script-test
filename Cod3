-- CONFIGURAÇÃO DE VELOCIDADE
local userTweenSpeed = 150

-- MOTOR DE TWEEN SUPREMO E RÁPIDO (ESTILO V9 CORRIGIDO E BLINDADO)
local function lightningTween(targetCFrame)
    local success = pcall(function()
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChild("Humanoid")
        
        if hrp and humanoid then
            humanoid.PlatformStand = true
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            
            local distance = (hrp.Position - targetCFrame.Position).Magnitude
            -- Cálculo otimizado por tempo com clamp dinâmico para garantir velocidade máxima sem travamentos
            local timeTaken = math.clamp(distance / userTweenSpeed, 0.05, 3.0)
            local startTime = tick()
            local startCFrame = hrp.CFrame
            
            while tick() - startTime < timeTaken do
                if not activeConnections then break end
                
                -- Trava de segurança: se estiver voltando com o ovo e ele sumir, aborta o trajeto para evitar bugs
                if player:GetAttribute("CarryEgg") ~= true and distance > 400 and startCFrame ~= hrp.CFrame then
                    break
                end
                
                local alpha = (tick() - startTime) / timeTaken
                local smoothAlpha = 1 - (1 - alpha) * (1 - alpha)
                
                hrp.CFrame = startCFrame:Lerp(targetCFrame, smoothAlpha)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                RunService.RenderStepped:Wait()
            end
            
            hrp.CFrame = targetCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.04)
            humanoid.PlatformStand = false
        end
    end)
    if not success then
        pcall(function() player.Character.Humanoid.PlatformStand = false end)
    end
end

