-- AUTO FARM DINÂMICO (Varredura de Ovos Próximos no Estágio)
local autoFarmActive = false
createToggle("🌾 Auto Farm Dinâmico (Varredura por Estágio)", function(s)
    autoFarmActive = s
end)

task.spawn(function()
    while true do
        if autoFarmActive then
            pcall(function()
                local stagePos = STAGE_MAP_TRAIL1[selectedTargetStage]
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if stagePos and hrp then
                    -- 1. VAI ATÉ O CENTRO DO ESTÁGIO SELECIONADO
                    safeTweenTeleport(CFrame.new(stagePos + Vector3.new(0, 3, 0)), 160)
                    task.wait(0.3)
                    
                    -- 2. VARRE A PASTA LOCALNESTS PROCURANDO PROXIMITY PROMPTS VIVOS NAQUELE RAIO
                    local localNests = Workspace:FindFirstChild("LocalNests")
                    local targetPrompt = nil
                    local minPromptDist = math.huge
                    
                    if localNests then
                        for _, desc in ipairs(localNests:GetDescendants()) do
                            if desc:IsA("ProximityPrompt") then
                                local promptPart = desc.Parent
                                local pPos = nil
                                if promptPart and promptPart:IsA("BasePart") then
                                    pPos = promptPart.Position
                                elseif promptPart and promptPart:IsA("Model") and promptPart.PrimaryPart then
                                    pPos = promptPart.PrimaryPart.Position
                                end
                                
                                if pPos then
                                    local distToStage = (stagePos - pPos).Magnitude
                                    -- Se o ovo estiver no raio de 120 studs do estágio selecionado
                                    if distToStage <= 120 then
                                        local distToPlayer = (hrp.Position - pPos).Magnitude
                                        if distToPlayer < minPromptDist then
                                            minPromptDist = distToPlayer
                                            targetPrompt = desc
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    -- 3. SE ENCONTROU UM OVO NO ESTÁGIO, VAI ATÉ ELE E ROUBA
                    if targetPrompt and targetPrompt.Parent then
                        local eggPart = targetPrompt.Parent
                        local eggCFrame = eggPart:IsA("BasePart") and eggPart.CFrame or (eggPart:IsA("Model") and eggPart:GetPivot() or nil)
                        
                        if eggCFrame then
                            safeTweenTeleport(eggCFrame + Vector3.new(0, 2, 0), 140)
                            task.wait(0.15)
                            
                            fireproximityprompt(targetPrompt)
                            if actionRemote then 
                                actionRemote:FireServer("PickUp", eggPart.Name) 
                                actionRemote:FireServer("StealEgg", eggPart.Name)
                            end
                            task.wait(0.3)
                        end
                    end
                    
                    -- 4. SE CARREGOU O OVO, VOLTA PARA A BASE E DEPOSITA
                    if player:GetAttribute("CarryEgg") == true then
                        if baseCFrame then
                            safeTweenTeleport(baseCFrame, 200)
                        else
                            local spawnPoint = Workspace:FindFirstChild("SpawnLocation")
                            if spawnPoint then safeTweenTeleport(spawnPoint.CFrame + Vector3.new(0, 3, 0), 200) end
                        end
                        
                        task.wait(0.4)
                        
                        if actionRemote then
                            actionRemote:FireServer("PlaceEgg")
                            actionRemote:FireServer("StoreEgg")
                            actionRemote:FireServer("HatchEgg")
                            actionRemote:FireServer("Deposit")
                        end
                        task.wait(0.6)
                    end
                end
            end)
        end
        task.wait(0.4)
    end
end)

