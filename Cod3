-- opções de raridade do pack, na ordem do jogo (ConveyorPacks.RarityRank)
local function loadPackRarities()
    local ranks, names = {}, {}
    local ok, cp = pcall(function() return require(RS.Modules.ConveyorPacks) end)
    if ok and type(cp) == "table" and type(cp.RarityRank) == "table" then
        for name, rank in pairs(cp.RarityRank) do
            if type(rank) == "number" and rank < 99 then
                ranks[name] = rank
                names[#names + 1] = name
            end
        end
    end
    if not ranks["Common"] then
        ranks["Common"] = 1
        names[#names + 1] = "Common"
    end
    table.sort(names, function(a, b)
        if ranks[a] ~= ranks[b] then
            return ranks[a] < ranks[b]
        end
        return a < b
    end)
    return names, ranks
end
