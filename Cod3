local function upgradeLoop()
    local cool = {}
    local total, reportAt, noticeAt = 0, os.clock(), -100
    while S.upgrade do
        local r = remote("CardSlotRE")
        if not r then
            Say("Auto melhorar", "Não achei CardSlotRE")
            break
        end
        local slots = occupiedSlots()
        if not slots or #slots == 0 then
            slots = {}
            for i = 1, CFG.MaxSlot do
                slots[i] = i
            end
        end
        local did = false
        for _, slot in ipairs(slots) do
            if not S.upgrade then
                break
            end
            if (cool[slot] or 0) <= os.clock() then
                local burst = 0
                while S.upgrade and burst < CFG.UpgradeBurst do
                    local stamp = S.upAck[slot] or 0
                    r:FireServer("UpgradeCard", { SlotIndex = slot })
                    local t0 = os.clock()
                    while (S.upAck[slot] or 0) == stamp and os.clock() - t0 < CFG.UpgradeAckWait do
                        task.wait(0.05)
                    end
                    if (S.upAck[slot] or 0) ~= stamp then
                        burst = burst + 1
                        total = total + 1
                        did = true
                        task.wait(CFG.UpgradeGap)
                    else
                        cool[slot] = os.clock() + 30 -- sem resposta: vazio, no máximo ou sem dinheiro
                        break
                    end
                end
            end
        end
        if os.clock() - reportAt > 30 and total > 0 then
            reportAt = os.clock()
            Say("Auto melhorar", total .. " melhorias até agora")
        end
        if not did then
            if os.clock() - noticeAt > 30 then
                noticeAt = os.clock()
                Say("Auto melhorar", "Nenhuma carta subiu. "
                    .. (S.lastPopup and ("O jogo disse: " .. S.lastPopup) or "Sem dinheiro ou todas no máximo?"))
            end
            task.wait(3)
        end
    end
end

