local isTeleporting = false
local function safeTweenTeleport(targetCFrame, speed)
    if isTeleporting then return end
    pcall(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            isTeleporting = true
            local hrp = char.HumanoidRootPart
            local humanoid = char.Humanoid
            humanoid.PlatformStand = true
            local distance = (hrp.Position - targetCFrame.Position).Magnitude
            local timeTaken = math.clamp(distance / (speed or 100), 0.1, 4.0)
            local startTime = tick()
            local startCFrame = hrp.CFrame
            
            while tick() - startTime < timeTaken do
                local alpha = (tick() - startTime) / timeTaken
                hrp.CFrame = startCFrame:Lerp(targetCFrame, math.clamp(alpha, 0, 1))
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                RunService.RenderStepped:Wait()
            end
            
            hrp.CFrame = targetCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.05)
            humanoid.PlatformStand = false
            isTeleporting = false
        end
    end)
end

