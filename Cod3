local function createToggle(text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(20, 12, 38)
    btn.TextColor3 = Color3.fromRGB(230, 200, 255)
    btn.Text = "   " .. text
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = scrollContainer
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(90, 40, 160)
    btnStroke.Thickness = 1
    btnStroke.Parent = btn
    
    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(110, 40, 200)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btnStroke.Color = Color3.fromRGB(210, 130, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(20, 12, 38)
            btn.TextColor3 = Color3.fromRGB(230, 200, 255)
            btnStroke.Color = Color3.fromRGB(90, 40, 160)
        end
        callback(active)
    end)
    return btn
end

-- AUTO FARM CORRIGIDO (Varredura Profunda na pasta Eggs e disparo correto do Remote)
local autoFarmActive = false
createToggle("🌾 Auto Farm Ancorado (Coleta Corrigida)", function(s)
    autoFarmActive = s
end)

task.spawn(function()
    while true do
        if autoFarmActive then
            pcall(function()
                local stagePos = STAGE_MAP_TRAIL1[selectedTargetStage]
                if stagePos then
                    -- 1. Ancora na fase selecionada
                    safeTweenTeleport(CFrame.new(stagePos + Vector3.new(0, 3, 0)), 120)
                    task.wait(0.3)
                    
                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local localNests = Workspace:FindFirstChild("LocalNests")
                    
                    if hrp and localNests then
                        -- Varre especificamente a pasta de Eggs e Nests para pegar o ID real
                        local searchFolders = {localNests:FindFirstChild("Eggs"), localNests:FindFirstChild("Nests"), localNests}
                        
                        for _, folder in ipairs(searchFolders) do
                            if folder then
                                for _, child in ipairs(folder:GetChildren()) do
                                    if not autoFarmActive then break end
                                    
                                    local cframeTarget = nil
                                    if child:IsA("Model") then
                                        cframeTarget = child:GetPivot()
                                    elseif child:IsA("BasePart") then
                                        cframeTarget = child.CFrame
                                    end
                                    
                                    if cframeTarget then
                                        local dist = (hrp.Position - cframeTarget.Position).Magnitude
                                        if dist <= 140 then
                                            safeTweenTeleport(cframeTarget * CFrame.new(0, 2, 0), 100)
                                            
                                            -- Dispara múltiplos padrões de Remote conhecidos do jogo para garantir o depósito na Base/Pen
                                            if actionRemote then
                                                actionRemote:FireServer("PickUp", child.Name)
                                                actionRemote:FireServer("Claim", child.Name)
                                                actionRemote:FireServer("StoreEgg", child.Name)
                                            end
                                            task.wait(0.2)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.4)
    end
end)

