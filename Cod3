local function createToggle(text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(20, 12, 38)
    btn.TextColor3 = Color3.fromRGB(230, 200, 255)
    btn.Text = "   " + text -- Fallback seguro
    btn.Text = "   " .. text
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = scrollContainer
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(90, 40, 160)
    btnStroke.Thickness = 1
    btnStroke.Parent = btn
    
    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(110, 40, 200)}):Play()
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btnStroke.Color = Color3.fromRGB(210, 130, 255)
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 12, 38)}):Play()
            btn.TextColor3 = Color3.fromRGB(230, 200, 255)
            btnStroke.Color = Color3.fromRGB(90, 40, 160)
        end
        callback(active)
    end)
    return btn
end

-- Teleporte Tween Seguro com PlatformStand e zeramento físico
local isTeleporting = false
local farmTweenSpeed = 100

local function safeTweenTeleport(targetCFrame, speed)
    if isTeleporting then return end
    pcall(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            isTeleporting = true
            local hrp = char.HumanoidRootPart
            local humanoid = char.Humanoid
            
            humanoid.PlatformStand = true
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            
            local distance = (hrp.Position - targetCFrame.Position).Magnitude
            local timeTaken = math.clamp(distance / (speed or 100), 0.1, 4.0)
            
            local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Linear)
            local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
            tween:Play()
            tween.Completed:Wait()
            
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.02)
            humanoid.PlatformStand = false
            isTeleporting = false
        end
    end)
end

