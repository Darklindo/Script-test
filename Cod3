-- pack mais valioso da mochila (packs têm o atributo Price; cartas têm CardName)
local function bestPack()
    local best, bestPrice
    for _, container in ipairs({ lp:FindFirstChild("Backpack"), lp.Character }) do
        if container then
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("CardName") == nil then
                    local price = t:GetAttribute("Price")
                    if type(price) == "number" and (not bestPrice or price > bestPrice) then
                        best, bestPrice = t, price
                    end
                end
            end
        end
    end
    return best
end

local function placeOpenLoop()
    local warned = false
    while S.place do
        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not fireproximityprompt then
            if not warned then
                warned = true
                Say("Colocar/abrir", "Seu executor não tem fireproximityprompt")
            end
            task.wait(5)
        elseif root and hum then
            local plotRoot = findMyPlot()
            if plotRoot then
                local readies, empties = {}, {}
                for _, d in ipairs(plotRoot:GetDescendants()) do
                    if d:IsA("ProximityPrompt") and d.Enabled and d.Parent and d.Parent.Name == "PromptHolder" then
                        if d.ActionText == "Open" then
                            readies[#readies + 1] = d
                        elseif d.ActionText == "Place" and d.ObjectText == "" then
                            empties[#empties + 1] = d
                        end
                    end
                end
                local origin = root.CFrame
                local acted = false
                for _, pr in ipairs(readies) do
                    if not S.place then
                        break
                    end
                    local pos = promptPos(pr)
                    if pos then
                        root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 3))
                        task.wait(0.15)
                        fireproximityprompt(pr)
                        acted = true
                        task.wait(CFG.PlaceOpenDelay)
                    end
                end
                for _, pr in ipairs(empties) do
                    if not S.place then
                        break
                    end
                    local pack = bestPack()
                    if not pack then
                        break
                    end
                    local pos = promptPos(pr)
                    if pos then
                        pcall(function() hum:EquipTool(pack) end)
                        local t0 = os.clock()
                        while pack.Parent ~= char and os.clock() - t0 < 1 do
                            task.wait(0.05)
                        end
                        root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 3))
                        task.wait(0.15)
                        fireproximityprompt(pr)
                        acted = true
                        task.wait(CFG.PlaceOpenDelay)
                    end
                end
                if acted then
                    root.CFrame = origin
                end
            end
            task.wait(5)
        else
            task.wait(1)
        end
    end
end

