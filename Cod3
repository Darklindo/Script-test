-- CONFIGURAÇÃO DE VELOCIDADE DO TWEEN
local userTweenSpeed = 100

-- TWEEN COM BYPASS DE FÍSICA E DESACELERAÇÃO SUAVE
local isTeleporting = false
local function ultraBypassTween(targetCFrame, customSpeed)
    if isTeleporting then return end
    pcall(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            isTeleporting = true
            local hrp = char.HumanoidRootPart
            local humanoid = char.Humanoid
            
            -- Bypass Anti-Cheat Física
            humanoid.PlatformStand = true
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            
            local speed = customSpeed or userTweenSpeed
            local distance = (hrp.Position - targetCFrame.Position).Magnitude
            local timeTaken = math.clamp(distance / speed, 0.1, 4.0)
            
            local startTime = tick()
            local startCFrame = hrp.CFrame
            
            while tick() - startTime < timeTaken do
                local elapsed = tick() - startTime
                local alpha = elapsed / timeTaken
                
                -- Curva de Easing Suave (Quad Out) para não perder o ovo na chegada
                local smoothAlpha = 1 - (1 - alpha) * (1 - alpha)
                
                hrp.CFrame = startCFrame:Lerp(targetCFrame, smoothAlpha)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                RunService.RenderStepped:Wait()
            end
            
            hrp.CFrame = targetCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.08)
            
            humanoid.PlatformStand = false
            isTeleporting = false
        end
    end)
end

