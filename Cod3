local function passesRarityFilter(item)
    local itemRarity = item:GetAttribute("Rarity") or item:GetAttribute("Tier")
    if not itemRarity then
        local rVal = item:FindFirstChild("Rarity") or item:FindFirstChild("Tier")
        if rVal and rVal:IsA("ValueBase") then
            itemRarity = rVal.Value
        end
    end
    itemRarity = tostring(itemRarity or "Common")
    
    local itemWeight = RARITY_HIERARCHY[itemRarity] or 1
    local minWeight = RARITY_HIERARCHY[selectedMinRarity] or 1
    return itemWeight >= minWeight
end

-- Auto Farm Direcionado (Varredura baseada em LocalNests e SwimWorld.Eggs)
local autoFarmActive = false
createToggle("🌾 Auto Farm (Nests & Eggs + Tween)", function(s)
    autoFarmActive = s
end)

task.spawn(function()
    while true do
        if autoFarmActive then
            pcall(function()
                local targets = {}
                
                -- Varre LocalNests confirmado pelo Scanner
                local localNests = Workspace:FindFirstChild("LocalNests")
                if localNests then
                    for _, child in ipairs(localNests:GetChildren()) do
                        if passesRarityFilter(child) then
                            table.insert(targets, child)
                        end
                    end
                end
                
                -- Varre SwimWorld.Eggs se existir
                local swimWorld = Workspace:FindFirstChild("SwimWorld")
                if swimWorld then
                    local eggsFolder = swimWorld:FindFirstChild("Eggs")
                    if eggsFolder then
                        for _, egg in ipairs(eggsFolder:GetChildren()) do
                            if passesRarityFilter(egg) then
                                table.insert(targets, egg)
                            end
                        end
                    end
                end
                
                for _, obj in ipairs(targets) do
                    if not autoFarmActive then break end
                    
                    local cframeTarget = nil
                    if obj:IsA("Model") then
                        cframeTarget = obj:GetPivot()
                    elseif obj:IsA("BasePart") then
                        cframeTarget = obj.CFrame
                    else
                        local p = obj:FindFirstChildWhichIsA("BasePart")
                        if p then cframeTarget = p.CFrame end
                    end
                    
                    if cframeTarget then
                        safeTweenTeleport(cframeTarget * CFrame.new(0, 3, 0), farmTweenSpeed)
                        
                        local guid = obj:GetAttribute("GUID") or obj:GetAttribute("Id") or obj.Name
                        if actionRemote then
                            actionRemote:FireServer("PickUp", guid)
                        end
                        task.wait(0.2)
                    end
                end
            end)
        end
        task.wait(0.3)
    end
end)

